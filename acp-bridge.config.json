{
  "routes": {
    "opencode": {
      "command": "~/.opencode/bin/opencode",
      "args": ["acp"],
      "yolo": false,
      "modelsCommand": {
        "command": "~/.opencode/bin/opencode",
        "args": ["models"]
      }
    },
    "cursor": {
      "command": "~/.local/bin/agent",
      "args": ["acp"],
      "yolo": false,
      "modelApply": "spawn-arg",
      "resumeMode": "cursor-acp-load",
      "resumeArgs": ["--resume", "{sessionId}"],
      "modelsCommand": {
        "command": "~/.local/bin/agent",
        "args": ["models"]
      }
    },
    "qodercli": {
      "command": "~/.local/bin/qodercli",
      "args": ["--acp"],
      "yolo": false,
      "modelApply": "spawn-arg",
      "resumeMode": "qoder-acp-load",
      "modelsCommand": {
        "command": "~/.local/bin/qodercli",
        "args": ["--list-models"]
      }
    }
  },
  "defaultRoute": "opencode",
  "yolo": false,
  "eventsPath": "./data/acp-events.jsonl",
  "routeStatePath": "./data/acp-route.json",
  "maxRawBytes": 2097152
}
